{
  "name": "opencode-quotas-extended",
  "version": "0.1.0",
  "private": true,
  "description": "Opencode quota hub plugin — extended provider list, SOLID/hexagonal rewrite",
  "type": "module",
  "packageManager": "bun@1.1.20",
  "bin": {
    "opencode-quotas": "dist/cli/index.js"
