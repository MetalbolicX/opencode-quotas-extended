{
  "name": "opencode-quotas-extended",
  "version": "0.1.0",
  "private": true,
  "description": "Opencode quota hub plugin — extended provider list, SOLID/hexagonal rewrite",
  "type": "module",
  "packageManager": "bun@1.1.20",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "opencode-quotas": "dist/cli/index.js"
  },
  "files": [
    "dist/",
    "schemas/",
    "commands/",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "build": "bun scripts/build.ts"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.1.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.1.0"
  }
}
